# Public website address, used for sitemap and SEO. Replace before launch.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# Enquiry emails (Nodemailer). For Hostinger email use smtp.hostinger.com with port 465.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@your-domain.com
SMTP_PASS=
# Where the enquiries are delivered
ENQUIRY_TO_EMAIL=info@your-domain.com
# Optional. Defaults to SMTP_USER
ENQUIRY_FROM_EMAIL=
